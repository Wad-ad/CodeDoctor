# CodeDoctor 后端配置模板
# 用法:复制本文件为 .env,填入你的 API Key
# 推荐 DeepSeek:https://platform.deepseek.com (注册后在「API Keys」页面创建)

# ---- 云端大模型(OpenAI 兼容协议)----
# 留空则降级为知识库规则模式;填 ollama 并把 BASE_URL 指向本地即用本地模型
CD_API_KEY=
CD_BASE_URL=https://api.deepseek.com
CD_MODEL=deepseek-chat

# ---- 服务与执行 ----
# 服务端口
CD_PORT=8000
# 代码执行的超时时间(秒),超过会被强制终止,用来防死循环
CD_EXEC_TIMEOUT=10

# ---- 知识库 ----
# Embedding 后端:ollama=本地模型(默认) / siliconflow=硅基流动云端(免费,不占本地资源)
CD_EMBED_PROVIDER=ollama
# 硅基流动 API Key(选 siliconflow 时必填;获取:cloud.siliconflow.cn → API 密钥)
CD_EMBED_API_KEY=
# 硅基流动 OpenAI 兼容地址(一般无需修改)
CD_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# Embedding 模型名:留空按 provider 自动选择(ollama→bge-m3 / siliconflow→BAAI/bge-m3)
# 注意:硅基流动免费版模型 ID 是 BAAI/bge-m3,不要写成 Pro/BAAI/bge-m3(收费版)
# CD_EMBED_MODEL=
# 本地 Ollama 地址(ollama 后端使用;需先执行:ollama pull bge-m3)
CD_OLLAMA_BASE=http://127.0.0.1:11434
# 检索注入条数上限
CD_KB_TOP_K=3
# 关闭向量检索(置 0 则只用 L1 精确索引)
CD_KB_VECTOR=1
# 向量检索距离上限(余弦距离,超出丢弃;越大越宽松)
CD_KB_MAX_DISTANCE=0.45

# ---- 案例文档库(RAG)----
# 上传的案例文档(md/txt/docx/pdf)自动切分、向量化入库;诊断时检索并注入「参考案例」
# 每次诊断从案例库召回的片段数
CD_CASE_TOP_K=2
# 案例检索距离上限(余弦距离;案例文本更长更杂,一般比知识库略宽松)
CD_CASE_MAX_DISTANCE=0.55

# ---- 诊断-修复-验证闭环 ----
# 修复代码最多验证几轮(未通过会带新报错重试)
CD_MAX_FIX_ROUNDS=3
# 云端接口结构化输出方式:function_calling / json_schema / json_mode
CD_STRUCTURED_METHOD=function_calling
